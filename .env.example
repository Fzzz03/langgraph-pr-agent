# --- LLM backend (free tier) ---
LLM_PROVIDER=groq
GROQ_API_KEY=your_groq_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# --- GitHub ---
GITHUB_TOKEN=your_github_token_here   # needs repo scope only if DRY_RUN=false

# --- Safety switch ---
# true  = write patch/tests to ./output/, never touch the real repo
# false = actually create a branch, commit, push, and open a PR
DRY_RUN=true
